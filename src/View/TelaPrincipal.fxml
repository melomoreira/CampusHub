<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane
    prefHeight="844.0"
    prefWidth="390.0"
    minHeight="600.0"
    minWidth="320.0"
    style="-fx-background-color: #F4F6FA;"
    xmlns="http://javafx.com/javafx/23"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="Controller.TelaPrincipalController">

    <!-- CABEÇALHO FIXO -->
    <top>
        <VBox spacing="10.0"
              style="-fx-background-color: #F4F6FA;">

            <padding>
                <Insets top="10.0"
                        right="10.0"
                        bottom="15.0"
                        left="10.0"/>
            </padding>

            <children>

                <!-- LOGO -->
                <HBox alignment="CENTER_LEFT"
                      prefHeight="70.0"
                      spacing="10.0">

                    <children>
                        <Label prefWidth="300.0"
                               style="-fx-font-size: 22px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #243B64;"
                               text="CAMPUS HUB"/>

                        <ImageView fitHeight="70.0"
                                   fitWidth="70.0"
                                   preserveRatio="true"
                                   pickOnBounds="true">
                            <image>
                                <Image url="@../imagens/CampusHub_Logo.png"/>
                            </image>
                            <HBox.margin>
                                <Insets right="10.0"/>
                            </HBox.margin>
                        </ImageView>
                    </children>
                </HBox>

                <!-- SAUDAÇÃO -->
                <Label fx:id="labelSaudacao"
                       wrapText="true"
                       style="-fx-font-size: 24px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #243B64;"
                       text="Olá, estudante!"/>

                <Label text="O que está acontecendo na sua universidade?"
                       wrapText="true"
                       style="-fx-font-size: 13px;
                              -fx-text-fill: #667085;"/>

            </children>
        </VBox>
    </top>

    <!-- CONTEÚDO CENTRAL COM SCROLL -->
    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    style="-fx-background-color: #F4F6FA;
                           -fx-background: #F4F6FA;">

            <content>
                <VBox spacing="15.0"
                      fillWidth="true"
                      style="-fx-background-color: #F4F6FA;">

                    <padding>
                        <Insets top="15.0"
                                right="18.0"
                                bottom="20.0"
                                left="18.0"/>
                    </padding>

                    <children>

                        <!-- CARROSSEL DE NOTIFICAÇÕES -->
                        <StackPane fx:id="painelNotificacoes"
                                   prefHeight="190.0"
                                   minHeight="190.0"
                                   maxWidth="Infinity"
                                   style="-fx-background-color: #243B64;
                                          -fx-background-radius: 15px;">

                            <padding>
                                <Insets top="13.0"
                                        right="13.0"
                                        bottom="10.0"
                                        left="13.0"/>
                            </padding>

                            <children>

                                <VBox fx:id="conteudoNotificacao"
                                      spacing="9.0"
                                      fillWidth="true">

                                    <children>

                                        <!-- TÍTULO DA CATEGORIA -->
                                        <HBox alignment="CENTER_LEFT"
                                              spacing="9.0">

                                            <children>

                                                <Label fx:id="iconeCategoria"
                                                       text="📅"
                                                       style="-fx-font-size: 23px;"/>

                                                <Label fx:id="tituloCategoria"
                                                       text="Agenda do dia"
                                                       wrapText="true"
                                                       maxWidth="230.0"
                                                       HBox.hgrow="ALWAYS"
                                                       style="-fx-font-size: 16px;
                                                              -fx-font-weight: bold;
                                                              -fx-text-fill: white;"/>

                                                <Label fx:id="numeroCategoria"
                                                       text="1 / 4"
                                                       style="-fx-font-size: 11px;
                                                              -fx-text-fill: #DCE7F5;"/>

                                            </children>
                                        </HBox>

                                        <!-- DESCRIÇÃO -->
                                        <Label fx:id="descricaoCategoria"
                                               text="Acompanhe seus compromissos e lembretes."
                                               wrapText="true"
                                               style="-fx-font-size: 11px;
                                                      -fx-text-fill: #DCE7F5;"/>

                                        <!-- NOTIFICAÇÕES DA CATEGORIA -->
                                        <VBox fx:id="listaItensNotificacao"
                                              spacing="6.0"
                                              fillWidth="true">

                                            <children>
                                                <Label text="Seus lembretes aparecerão aqui."
                                                       wrapText="true"
                                                       style="-fx-font-size: 12px;
                                                              -fx-text-fill: white;"/>
                                            </children>
                                        </VBox>

                                        <!-- CONTROLES DO CARROSSEL -->
                                        <HBox alignment="CENTER"
                                              spacing="8.0">

                                            <children>

                                                <Button text="‹"
                                                        onAction="#notificacaoAnterior"
                                                        focusTraversable="false"
                                                        style="-fx-background-color: transparent;
                                                               -fx-text-fill: white;
                                                               -fx-font-size: 23px;
                                                               -fx-padding: 0 8 0 8;
                                                               -fx-cursor: hand;"/>

                                                <HBox fx:id="indicadoresNotificacao"
                                                      alignment="CENTER"
                                                      spacing="7.0"
                                                      HBox.hgrow="ALWAYS">

                                                    <children>
                                                        <Label text="●"
                                                               style="-fx-font-size: 12px;
                                                                      -fx-text-fill: white;"/>
                                                    </children>
                                                </HBox>

                                                <Button text="›"
                                                        onAction="#proximaNotificacao"
                                                        focusTraversable="false"
                                                        style="-fx-background-color: transparent;
                                                               -fx-text-fill: white;
                                                               -fx-font-size: 23px;
                                                               -fx-padding: 0 8 0 8;
                                                               -fx-cursor: hand;"/>

                                            </children>
                                        </HBox>

                                    </children>
                                </VBox>

                            </children>
                        </StackPane>

                        <!-- ACESSO RÁPIDO -->
                        <Label text="Acesso rápido"
                               style="-fx-font-size: 18px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #243B64;"/>

                        <VBox spacing="10.0"
                              fillWidth="true">

                            <children>

                                <!-- PRIMEIRA LINHA -->
                                <HBox alignment="CENTER"
                                      spacing="12.0">

                                    <children>

                                        <VBox fx:id="botaoEventos"
                                              alignment="CENTER"
                                              onMouseClicked="#abrirEventos"
                                              prefHeight="80.0"
                                              HBox.hgrow="ALWAYS"
                                              spacing="8.0"
                                              style="-fx-background-color: #E5EBF4;
                                                     -fx-background-radius: 12px;
                                                     -fx-cursor: hand;">

                                            <children>
                                                <Label text="📅 Eventos"
                                                       style="-fx-font-size: 14px;
                                                              -fx-font-weight: bold;
                                                              -fx-text-fill: #243B64;"/>
                                            </children>
                                        </VBox>

                                        <VBox fx:id="botaoGrupos"
                                              alignment="CENTER"
                                              onMouseClicked="#abrirGrupos"
                                              prefHeight="80.0"
                                              HBox.hgrow="ALWAYS"
                                              spacing="8.0"
                                              style="-fx-background-color: #E5EBF4;
                                                     -fx-background-radius: 12px;
                                                     -fx-cursor: hand;">

                                            <children>
                                                <Label text="👥 Grupos"
                                                       style="-fx-font-size: 14px;
                                                              -fx-font-weight: bold;
                                                              -fx-text-fill: #243B64;"/>
                                            </children>
                                        </VBox>

                                    </children>
                                </HBox>

                                <!-- SEGUNDA LINHA -->
                                <HBox alignment="CENTER"
                                      spacing="12.0">

                                    <children>

                                        <VBox fx:id="botaoAcademico"
                                              alignment="CENTER"
                                              onMouseClicked="#abrirAcademico"
                                              prefHeight="80.0"
                                              HBox.hgrow="ALWAYS"
                                              spacing="8.0"
                                              style="-fx-background-color: #E5EBF4;
                                                     -fx-background-radius: 12px;
                                                     -fx-cursor: hand;">

                                            <children>
                                                <Label text="📚 Acadêmico"
                                                       style="-fx-font-size: 14px;
                                                              -fx-font-weight: bold;
                                                              -fx-text-fill: #243B64;"/>
                                            </children>
                                        </VBox>

                                        <VBox fx:id="botaoAtletica"
                                              alignment="CENTER"
                                              onMouseClicked="#abrirAtletica"
                                              prefHeight="80.0"
                                              HBox.hgrow="ALWAYS"
                                              spacing="8.0"
                                              style="-fx-background-color: #E5EBF4;
                                                     -fx-background-radius: 12px;
                                                     -fx-cursor: hand;">

                                            <children>
                                                <Label text="🏆 Atlética"
                                                       style="-fx-font-size: 14px;
                                                              -fx-font-weight: bold;
                                                              -fx-text-fill: #243B64;"/>
                                            </children>
                                        </VBox>

                                    </children>
                                </HBox>

                                <!-- TERCEIRA LINHA -->
                                <HBox alignment="CENTER">

                                    <children>

                                        <VBox fx:id="botaoMapa"
                                              alignment="CENTER"
                                              onMouseClicked="#abrirMapa"
                                              prefHeight="65.0"
                                              maxWidth="Infinity"
                                              HBox.hgrow="ALWAYS"
                                              style="-fx-background-color: #243B64;
                                                     -fx-background-radius: 12px;
                                                     -fx-cursor: hand;">

                                            <children>
                                                <Label text="Mapa do Campus"
                                                       style="-fx-font-size: 14px;
                                                              -fx-font-weight: bold;
                                                              -fx-text-fill: white;"/>
                                            </children>
                                        </VBox>

                                    </children>
                                </HBox>

                            </children>
                        </VBox>

                        <!-- PRÓXIMOS EVENTOS -->
                        <Label text="Próximos eventos"
                               style="-fx-font-size: 18px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #243B64;"/>

                        <VBox fx:id="listaProximosEventos"
                              spacing="10.0"
                              fillWidth="true"
                              maxWidth="Infinity"/>

                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>

    <!-- NAVEGAÇÃO INFERIOR FIXA -->
    <bottom>
        <HBox alignment="CENTER"
              minHeight="100.0"
              prefHeight="100.0"
              prefWidth="390.0"
              spacing="20.0"
              style="-fx-background-color: white;
                     -fx-border-width: 1px;
                     -fx-background-radius: 12px;">

            <children>

                <VBox fx:id="navInicio"
                      alignment="CENTER"
                      onMouseClicked="#abrirInicio"
                      prefWidth="75.0"
                      spacing="5.0">

                    <children>
                        <Label text="🏠 Início"
                               style="-fx-font-size: 12px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #243B64;"/>
                    </children>

                    <padding>
                        <Insets bottom="35.0"/>
                    </padding>
                </VBox>

                <VBox fx:id="navEventos"
                      alignment="CENTER"
                      onMouseClicked="#abrirEventos"
                      prefWidth="75.0"
                      spacing="5.0">

                    <children>
                        <Label text="📅 Eventos"
                               style="-fx-font-size: 12px;
                                      -fx-text-fill: #667085;"/>
                    </children>

                    <padding>
                        <Insets bottom="35.0"/>
                    </padding>
                </VBox>

                <VBox fx:id="navGrupos"
                      alignment="CENTER"
                      onMouseClicked="#abrirGrupos"
                      prefWidth="75.0"
                      spacing="5.0">

                    <children>
                        <Label text="👥 Grupos"
                               style="-fx-font-size: 12px;
                                      -fx-text-fill: #667085;"/>
                    </children>

                    <padding>
                        <Insets bottom="35.0"/>
                    </padding>
                </VBox>

                <VBox fx:id="navPerfil"
                      alignment="CENTER"
                      onMouseClicked="#abrirPerfil"
                      prefWidth="75.0"
                      spacing="5.0">

                    <children>
                        <Label text="👤 Perfil"
                               style="-fx-font-size: 12px;
                                      -fx-text-fill: #667085;"/>
                    </children>

                    <padding>
                        <Insets bottom="35.0"/>
                    </padding>
                </VBox>

            </children>
        </HBox>
    </bottom>

</BorderPane>