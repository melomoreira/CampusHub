<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="844.0"
            prefWidth="390.0"
            minHeight="600.0"
            minWidth="320.0"
            style="-fx-background-color: #F4F6FA;"
            xmlns="http://javafx.com/javafx/23"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controller.TelaAcademicaController">

    <!-- CABEÇALHO -->
    <top>
        <VBox spacing="12.0"
              style="-fx-background-color: #F4F6FA;">

            <padding>
                <Insets top="10.0"
                        right="10.0"
                        bottom="15.0"
                        left="10.0"/>
            </padding>

            <children>

                <!-- LOGO -->
                <HBox alignment="CENTER_LEFT"
                      prefHeight="70.0"
                      spacing="10.0">

                    <children>
                        <Label prefWidth="300.0"
                               style="-fx-font-size: 22px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #243B64;"
                               text="CAMPUS HUB"/>

                        <ImageView fitHeight="70.0"
                                   fitWidth="70.0"
                                   preserveRatio="true"
                                   pickOnBounds="true">
                            <image>
                                <Image url="@../imagens/CampusHub_Logo.png"/>
                            </image>
                            <HBox.margin>
                                <Insets right="10.0"/>
                            </HBox.margin>
                        </ImageView>
                    </children>
                </HBox>

                <!-- TÍTULO -->
                <Label text="Acadêmico"
                       style="-fx-font-size: 24px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #243B64;"/>

                <Label text="Tudo para facilitar sua vida universitária."
                       wrapText="true"
                       style="-fx-font-size: 13px;
                              -fx-text-fill: #667085;"/>

            </children>
        </VBox>
    </top>

    <!-- CONTEÚDO -->
    <center>
        <VBox spacing="15.0"
              style="-fx-background-color: #F4F6FA;">

            <padding>
                <Insets top="15.0"
                        right="18.0"
                        bottom="20.0"
                        left="18.0"/>
            </padding>

            <children>

                <Label text="Área acadêmica"
                       style="-fx-font-size: 18px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #243B64;"/>

                <!-- MURAL -->
                <VBox fx:id="cartaoMural"
                      alignment="CENTER_LEFT"
                      onMouseClicked="#abrirMural"
                      prefHeight="115.0"
                      spacing="8.0"
                      style="-fx-background-color: white;
                             -fx-background-radius: 12px;
                             -fx-padding: 15px;">

                    <children>
                        <Label text="📢  Mural acadêmico"
                               style="-fx-font-size: 16px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #243B64;"/>

                        <Label text="Avisos, comunicados e oportunidades universitárias."
                               wrapText="true"
                               style="-fx-font-size: 12px;
                                      -fx-text-fill: #667085;"/>
                    </children>
                </VBox>

                <!-- MONITORIAS -->
                <VBox fx:id="cartaoMonitorias"
                      alignment="CENTER_LEFT"
                      onMouseClicked="#abrirMonitorias"
                      prefHeight="115.0"
                      spacing="8.0"
                      style="-fx-background-color: white;
                             -fx-background-radius: 12px;
                             -fx-padding: 15px;">

                    <children>
                        <Label text="👥  Monitorias e estudos"
                               style="-fx-font-size: 16px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #243B64;"/>

                        <Label text="Encontre monitorias e grupos de estudo."
                               wrapText="true"
                               style="-fx-font-size: 12px;
                                      -fx-text-fill: #667085;"/>
                    </children>
                </VBox>

                <!-- AGENDA -->
                <VBox fx:id="cartaoAgenda"
                      alignment="CENTER_LEFT"
                      onMouseClicked="#abrirAgenda"
                      prefHeight="115.0"
                      spacing="8.0"
                      style="-fx-background-color: white;
                             -fx-background-radius: 12px;
                             -fx-padding: 15px;">

                    <children>
                        <Label text="📅  Agenda acadêmica"
                               style="-fx-font-size: 16px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #243B64;"/>

                        <Label text="Organize provas, trabalhos e compromissos."
                               wrapText="true"
                               style="-fx-font-size: 12px;
                                      -fx-text-fill: #667085;"/>
                    </children>
                </VBox>

                <!-- MATERIAIS -->
                <VBox fx:id="cartaoMateriais"
                      alignment="CENTER_LEFT"
                      onMouseClicked="#abrirMateriais"
                      prefHeight="115.0"
                      spacing="8.0"
                      style="-fx-background-color: white;
                             -fx-background-radius: 12px;
                             -fx-padding: 15px;">

                    <children>
                        <Label text="📚  Materiais de estudo"
                               style="-fx-font-size: 16px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #243B64;"/>

                        <Label text="Consulte referências e materiais acadêmicos."
                               wrapText="true"
                               style="-fx-font-size: 12px;
                                      -fx-text-fill: #667085;"/>
                    </children>
                </VBox>

            </children>
        </VBox>
    </center>

    <!-- NAVEGAÇÃO INFERIOR -->
    <bottom>
        <HBox alignment="CENTER"
              minHeight="100.0"
              prefHeight="100.0"
              prefWidth="390.0"
              spacing="20.0"
              style="-fx-background-color: white;
                     -fx-border-width: 1px;
                     -fx-background-radius: 12px;">

            <children>

                <VBox fx:id="navInicio"
                      alignment="CENTER"
                      onMouseClicked="#abrirInicio"
                      prefWidth="75.0"
                      spacing="5.0">
                    <children>
                        <Label text="🏠 Início"
                               style="-fx-font-size: 12px;
                                      -fx-text-fill: #667085;"/>
                    </children>
                    <padding>
                        <Insets bottom="35.0"/>
                    </padding>
                </VBox>

                <VBox fx:id="navEventos"
                      alignment="CENTER"
                      onMouseClicked="#abrirEventos"
                      prefWidth="75.0"
                      spacing="5.0">
                    <children>
                        <Label text="📅 Eventos"
                               style="-fx-font-size: 12px;
                                      -fx-text-fill: #667085;"/>
                    </children>
                    <padding>
                        <Insets bottom="35.0"/>
                    </padding>
                </VBox>

                <VBox fx:id="navGrupos"
                      alignment="CENTER"
                      onMouseClicked="#abrirGrupos"
                      prefWidth="75.0"
                      spacing="5.0">
                    <children>
                        <Label text="👥 Grupos"
                               style="-fx-font-size: 12px;
                                      -fx-text-fill: #667085;"/>
                    </children>
                    <padding>
                        <Insets bottom="35.0"/>
                    </padding>
                </VBox>

                <VBox fx:id="navPerfil"
                      alignment="CENTER"
                      onMouseClicked="#abrirPerfil"
                      prefWidth="75.0"
                      spacing="5.0">
                    <children>
                        <Label text="👤 Perfil"
                               style="-fx-font-size: 12px;
                                      -fx-text-fill: #667085;"/>
                    </children>
                    <padding>
                        <Insets bottom="35.0"/>
                    </padding>
                </VBox>

            </children>
        </HBox>
    </bottom>

</BorderPane>