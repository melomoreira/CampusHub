<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane minHeight="-Infinity"
            minWidth="-Infinity"
            prefHeight="844.0"
            prefWidth="390.0"
            style="-fx-background-color: #F4F6FA;"
            xmlns="http://javafx.com/javafx/23"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controller.TelaAtleticaController">

    <!-- CABEÇALHO -->
    <top>
        <VBox spacing="12.0"
              style="-fx-background-color: #F4F6FA;"
              BorderPane.alignment="CENTER">

            <children>
                <HBox alignment="CENTER_LEFT"
                      prefHeight="70.0"
                      spacing="10.0">

                    <children>
                        <Label prefWidth="300.0"
                               style="-fx-font-size: 22px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #243B64;"
                               text="CAMPUS HUB"/>

                        <ImageView fitHeight="70.0"
                                   fitWidth="70.0"
                                   pickOnBounds="true"
                                   preserveRatio="true">
                            <image>
                                <Image url="@../imagens/CampusHub_Logo.png"/>
                            </image>

                            <HBox.margin>
                                <Insets right="10.0"/>
                            </HBox.margin>
                        </ImageView>
                    </children>
                </HBox>

                <VBox spacing="4.0">
                    <children>
                        <Label style="-fx-font-size: 24px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #243B64;"
                               text="Atlética"/>

                        <Label style="-fx-font-size: 13px;
                                      -fx-text-fill: #667085;"
                               text="Esporte, integração e espírito universitário."
                               wrapText="true"/>
                    </children>
                </VBox>
            </children>

            <padding>
                <Insets top="10.0"
                        right="10.0"
                        bottom="15.0"
                        left="10.0"/>
            </padding>
        </VBox>
    </top>

    <!-- CONTEÚDO -->
    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    style="-fx-background-color: #F4F6FA;
                           -fx-background: #F4F6FA;"
                    BorderPane.alignment="CENTER">

            <content>
                <VBox spacing="15.0"
                      style="-fx-background-color: #F4F6FA;">

                    <children>
                        <Label style="-fx-font-size: 18px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #243B64;"
                               text="Explore a Atlética"/>

                        <!-- MODALIDADES -->
                        <VBox fx:id="cartaoModalidades"
                              onMouseClicked="#abrirModalidades"
                              spacing="8.0"
                              style="-fx-background-color: white;
                                     -fx-background-radius: 12px;
                                     -fx-padding: 15px;">

                            <children>
                                <Label style="-fx-font-size: 16px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #243B64;"
                                       text="🏀 Modalidades esportivas"/>

                                <Label style="-fx-font-size: 13px;
                                              -fx-text-fill: #667085;"
                                       text="Conheça os esportes disponíveis e encontre uma modalidade para participar."
                                       wrapText="true"/>
                            </children>
                        </VBox>

                        <!-- EQUIPES E SELETIVAS -->
                        <VBox fx:id="cartaoEquipes"
                              onMouseClicked="#abrirEquipes"
                              spacing="8.0"
                              style="-fx-background-color: white;
                                     -fx-background-radius: 12px;
                                     -fx-padding: 15px;">

                            <children>
                                <Label style="-fx-font-size: 16px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #243B64;"
                                       text="👥 Equipes e seletivas"/>

                                <Label style="-fx-font-size: 13px;
                                              -fx-text-fill: #667085;"
                                       text="Conheça as equipes universitárias e acompanhe oportunidades de participação."
                                       wrapText="true"/>
                            </children>
                        </VBox>

                        <!-- CAMPEONATOS -->
                        <VBox fx:id="cartaoCampeonatos"
                              onMouseClicked="#abrirCampeonatos"
                              spacing="8.0"
                              style="-fx-background-color: white;
                                     -fx-background-radius: 12px;
                                     -fx-padding: 15px;">

                            <children>
                                <Label style="-fx-font-size: 16px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #243B64;"
                                       text="🏆 Campeonatos e competições"/>

                                <Label style="-fx-font-size: 13px;
                                              -fx-text-fill: #667085;"
                                       text="Consulte competições, jogos, calendário e resultados."
                                       wrapText="true"/>
                            </children>
                        </VBox>

                        <!-- NOTÍCIAS -->
                        <VBox fx:id="cartaoNoticias"
                              onMouseClicked="#abrirNoticias"
                              spacing="8.0"
                              style="-fx-background-color: white;
                                     -fx-background-radius: 12px;
                                     -fx-padding: 15px;">

                            <children>
                                <Label style="-fx-font-size: 16px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #243B64;"
                                       text="📢 Notícias e comunicados"/>

                                <Label style="-fx-font-size: 13px;
                                              -fx-text-fill: #667085;"
                                       text="Fique por dentro dos avisos, novidades e atividades da Atlética."
                                       wrapText="true"/>
                            </children>
                        </VBox>
                    </children>

                    <padding>
                        <Insets top="15.0"
                                right="18.0"
                                bottom="20.0"
                                left="18.0"/>
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
    </center>

    <!-- NAVEGAÇÃO INFERIOR -->
    <bottom>
        <HBox alignment="CENTER"
              minHeight="100.0"
              prefHeight="100.0"
              spacing="20.0"
              style="-fx-background-color: white;
                     -fx-border-width: 1px;
                     -fx-background-radius: 12px;"
              BorderPane.alignment="CENTER">

            <children>
                <VBox fx:id="navInicio"
                      alignment="CENTER"
                      onMouseClicked="#abrirInicio"
                      prefHeight="55.0"
                      prefWidth="75.0"
                      spacing="5.0">

                    <children>
                        <Label style="-fx-font-size: 12px;
                                      -fx-text-fill: #667085;"
                               text="🏠 Início"/>
                    </children>

                    <padding>
                        <Insets bottom="35.0"/>
                    </padding>
                </VBox>

                <VBox fx:id="navEventos"
                      alignment="CENTER"
                      onMouseClicked="#abrirEventos"
                      prefHeight="55.0"
                      prefWidth="75.0"
                      spacing="5.0">

                    <children>
                        <Label style="-fx-font-size: 12px;
                                      -fx-text-fill: #667085;"
                               text="📅 Eventos"/>
                    </children>

                    <padding>
                        <Insets bottom="35.0"/>
                    </padding>
                </VBox>

                <VBox fx:id="navGrupos"
                      alignment="CENTER"
                      onMouseClicked="#abrirGrupos"
                      prefHeight="55.0"
                      prefWidth="75.0"
                      spacing="5.0">

                    <children>
                        <Label style="-fx-font-size: 12px;
                                      -fx-text-fill: #667085;"
                               text="👥 Grupos"/>
                    </children>

                    <padding>
                        <Insets bottom="35.0"/>
                    </padding>
                </VBox>

                <VBox fx:id="navPerfil"
                      alignment="CENTER"
                      onMouseClicked="#abrirPerfil"
                      prefHeight="55.0"
                      prefWidth="75.0"
                      spacing="5.0">

                    <children>
                        <Label style="-fx-font-size: 12px;
                                      -fx-text-fill: #667085;"
                               text="👤 Perfil"/>
                    </children>

                    <padding>
                        <Insets bottom="35.0"/>
                    </padding>
                </VBox>
            </children>
        </HBox>
    </bottom>

</BorderPane>